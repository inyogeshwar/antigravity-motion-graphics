{
  "name": "antigravity-motion-graphics",
  "version": "1.1.0",
  "description": "MotionOS: Deterministic Motion Design & Vibe Editing OS in Google Antigravity",
  "main": "lib/motion.js",
  "type": "module",
  "bin": {
    "motionos": "bin/cli.js",
    "motion-os": "bin/cli.js",
    "antigravity-motion": "bin/cli.js",
    "antigravity-motion-graphics": "bin/create.js",
    "create-antigravity-motion": "bin/create.js"
  },
  "files": [
    "bin",
    "templates",
    "lib",
    "render.mjs",
    "sfx.mjs",
    "voice.mjs",
    "cartesia.mjs",
    "heygen.mjs",
    "beats.py",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:py": "python -m unittest discover tests",
    "test:all": "node --test tests/*.test.js && python -m unittest discover tests",
    "render": "node render.mjs",
    "render:hq": "node render.mjs --sub 4 --crf 16",
    "sfx": "node sfx.mjs",
    "voice": "node voice.mjs",
    "cartesia": "node cartesia.mjs",
    "heygen": "node heygen.mjs",
    "beats": "python beats.py",
    "veos": "node bin/vibe.js",
    "previews": "node scripts/build_previews.mjs",
    "setup-models": "node scripts/setup_models.mjs",
    "remotion:studio": "remotion studio",
    "remotion:render": "remotion render",
    "vibe": "node bin/vibe.js"
  },
  "keywords": [
    "motion-graphics",
    "antigravity",
    "remotion",
    "hyperframes",
    "gsap",
    "video-code",
    "motion-design",
    "deterministic-rendering",
    "spring-physics"
  ],
  "author": "Yogeshwar Kumar <111217412+inyogeshwar@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inyogeshwar/antigravity-motion-graphics.git"
  },
  "license": "MIT",
  "dependencies": {
    "gsap": "^3.15.0",
    "playwright": "^1.64.1"
  }
}
