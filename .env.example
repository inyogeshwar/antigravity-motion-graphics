# Antigravity Motion Graphics - Environment Variables Example
# Copy this file to .env and supply your credentials:
# cp .env.example .env

# -----------------------------------------------------------------------------
# AI Voice Generation Engines (Optional)
# -----------------------------------------------------------------------------

# Cartesia AI (Flagship sonic-3.6 multilingual model)
# Obtain from: https://play.cartesia.ai/keys
CARTESIA_API_KEY=your_cartesia_api_key_here

# HeyGen AI (Voice Turbo Free tier - $0 / million chars)
# Obtain from: https://app.heygen.com/settings?tab=api
HEYGEN_API_KEY=your_heygen_api_key_here

# -----------------------------------------------------------------------------
# System & Engine Configurations (Optional overrides)
# -----------------------------------------------------------------------------

# Explicit path to ffmpeg binary (if not available in system PATH)
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
